$black: #000000;
$surface: #1d2021;
$surface-raised: #282828;
$border: #3c3836;
$text: #ebdbb2;
$bright: #fbf1c7;
$muted: #a89984;
$yellow: #fabd2f;
$green: #b8bb26;
$orange: #fe8019;
$red: #fb4934;

Screen {
    background: $black;
    color: $text;
}

Screen > Header {
    background: $black;
    color: $text;
    border-bottom: solid $border;
}

#body {
    height: 1fr;
}

#sidebar {
    width: 24;
    min-width: 21;
    background: $black;
    border-right: solid $border;
    padding: 1 0 0 0;
}

.section-title {
    height: 2;
    padding: 0 2;
    color: $yellow;
    text-style: bold;
    content-align: left middle;
}

#workflow-list {
    height: 1fr;
    background: $black;
    border: none;
    padding: 0 1;
    scrollbar-color: $yellow;
    scrollbar-background: $surface;
}

#workflow-list > ListItem {
    height: 2;
    padding: 0 1;
    color: $muted;
    content-align: left middle;
}

#workflow-list > ListItem.--highlight {
    background: $surface-raised;
    color: $bright;
    border-left: thick $yellow;
    text-style: bold;
}

#workflow-list:focus > ListItem.--highlight {
    background: $surface-raised;
    color: $bright;
    border-left: thick $yellow;
    text-style: bold;
}

#workflow-list:disabled > ListItem.--highlight {
    border-left: thick $orange;
    color: $muted;
}

#workspace {
    width: 1fr;
    padding: 0 1;
    background: $black;
}

#stats {
    height: 3;
    padding: 1 1 0 1;
    background: $black;
    color: $text;
    border-bottom: solid $border;
}

#tables {
    height: 1fr;
    background: $black;
}

Tabs {
    background: $black;
    color: $muted;
}

Tab {
    background: $black;
    color: $muted;
}

Tab.-active {
    background: $black;
    color: $yellow;
    text-style: bold;
}

TabbedContent Tabs > Underline > .underline--bar,
TabbedContent Tabs:focus > Underline > .underline--bar {
    color: $yellow;
    background: $surface;
}

TabbedContent > ContentSwitcher {
    background: $black;
    border-top: solid $border;
}

DataTable {
    height: 1fr;
    background: $black;
    color: $text;
    scrollbar-color: $yellow;
    scrollbar-background: $surface;
}

DataTable > .datatable--header {
    background: $surface;
    color: $yellow;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $surface-raised;
    color: $bright;
    text-style: bold;
}

#workflow-output {
    height: 1fr;
    padding: 1 2;
    background: $black;
    color: $text;
    scrollbar-color: $yellow;
    scrollbar-background: $surface;
}

#launcher {
    height: 9;
    padding: 1 2 0 2;
    background: $surface;
    border-top: solid $border;
}

#workflow-title {
    height: 1;
    color: $yellow;
    text-style: bold;
}

#workflow-description {
    height: 1;
    color: $muted;
}

#workflow-arguments {
    margin-top: 0;
    background: $black;
    color: $bright;
    border: tall $border;
}

#workflow-arguments:focus {
    border: tall $yellow;
}

#workflow-arguments:disabled {
    color: $muted;
    border: tall $border;
}

#launcher-actions {
    height: 3;
    margin-top: 0;
    align-vertical: middle;
}

#run {
    min-width: 18;
    background: $yellow;
    color: $black;
    text-style: bold;
}

#run:hover,
#run:focus {
    background: $orange;
    color: $black;
}

#run.-warning {
    background: $red;
    color: $black;
}

#launcher-help {
    width: 1fr;
    padding: 1 0 0 2;
    color: $muted;
    text-align: right;
}

#status-line {
    height: 2;
    padding: 0 1;
    color: $green;
    background: $black;
}

Footer {
    background: $black;
    color: $muted;
}
